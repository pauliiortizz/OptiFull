{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "py",
      "runtimeArgs": ["-c", "import sys; sys.path.insert(0, 'frontend'); from api import app; app.run(host='127.0.0.1', port=8090, threaded=True)"],
      "port": 8090,
      "autoPort": false
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "--port", "5173", "--strictPort"],
      "env": { "OPTIFULL_API": "http://localhost:8090" },
      "port": 5173,
      "autoPort": false
    }
  ]
}
