erDiagram
    CAMARAS ||--o{ SESIONES_VIDEO : registra
    CAMARAS ||--o{ ZONAS : define
    SESIONES_VIDEO ||--o{ PERSONAS : detecta
    PERSONAS |o--o{ PERSONAS : "cliente_id (Re-ID)"
    EMPLEADOS |o--o{ PERSONAS : identifica
    PERSONAS ||--o{ TRAYECTORIAS : recorre
    ZONAS |o--o{ TRAYECTORIAS : contiene
    PERSONAS ||--o{ VISITAS : realiza
    VISITAS |o--o{ EVENTOS : clasifica
    PERSONAS ||--o{ ALERTAS : genera
    CAMARAS ||--o{ MAPAS_CALOR : acumula
    SESIONES_VIDEO |o--o{ MAPAS_CALOR : produce
    ROLES ||--o{ USUARIOS : asigna
    USUARIOS }o--o{ SUCURSALES : accede
    PRODUCTOS ||--o{ TRANSACCIONES : descuenta

    CAMARAS {
        int id PK
        string nombre
        string rtsp_url
    }
    SESIONES_VIDEO {
        int id PK
        int camara_id FK
        timestamp inicio
        timestamp fin
        timestamp heartbeat
    }
    ZONAS {
        int id PK
        int camara_id FK
        string tipo
        json poligono
    }
    PERSONAS {
        int id PK
        int sesion_id FK
        int cliente_id FK
        bool es_empleado
        string metodo_reid
        string descripcion_visual
    }
    TRAYECTORIAS {
        int persona_id FK
        int zona_id FK
        timestamp timestamp
        float centroide_x
        float centroide_y
    }
    VISITAS {
        int id PK
        int persona_id FK
        timestamp entrada
        timestamp salida
    }
    EVENTOS {
        int visita_id FK
        string accion_detectada
        bool tomo_producto
        bool paso_por_caja
        json secuencia_zonas
    }
    ALERTAS {
        int id PK
        int persona_id FK
        string tipo
        bool resuelta
        json evidencia
    }
    MAPAS_CALOR {
        int id PK
        int camara_id FK
        json matriz
        float area_activa_pct
    }
    PRODUCTOS {
        string sku PK
        string marca
        string variante
        float tamano_valor
        int cantidad
    }
    TRANSACCIONES {
        string sku FK
        int cantidad
        float confianza_llm
        string estado_matching
    }
    USUARIOS {
        int id PK
        int rol_id FK
        string usuario
        string clave_hash
    }
    ROLES {
        int id PK
        string nombre
    }
    SUCURSALES {
        int id PK
        string nombre
    }
    EMPLEADOS {
        int id PK
        string nombre
    }
